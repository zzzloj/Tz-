              {
                "lacks": "i.a.m.vlast"
              },
              {
                "has": "i.q.darklist"
              },
              {
                "lacks": "i.q.darklist",
                "count": 3
              }
            ]
          },
          {
            "label": "Твой город? э... а ты вообще кто такой?",
            "goto": "who",
            "if": [
              {
                "lacks": "i.a.m.vlast"
              },
              {
                "lacks": "i.q.darklist"
              }
            ]
          },
          {
            "label": "Что ты продаешь?",
            "goto": "buyinfo"
          },
          {
            "label": "Что то не нравится мне твой жуткий вид, проваливай пока я не почисал об тебя свой меч.",
            "goto": "chu"
          },
          {
            "label": "Упсс мне некогда давай пообщаемся в другой раз.",
            "goto": "end"
          }
        ]
      },
