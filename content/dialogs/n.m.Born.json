{
    "id": "n.m.Born",
    "topics": {
        "begin": {
            "text": "Привет, <imja>. У меня лучшие волшебные элексиры. Так же у меня есть напитки и элексиры востановления, которые особенно понравятся магам",
            "options": [
                {
                    "label": "Можно взглянуть на твои товары?",
                    "goto": "buy"
                },
                {
                    "label": "У меня есть зелья на продажу",
                    "goto": "sell"
                },
                {
                    "label": "eval: if(legacy_cmp(additem($loc,$login,\"\",\"i.q.hz\",\"count\"))>0) $title_v=\"Слушай Борн, ты не в курсе, что это за снадобье такое?\"; else $title_v=\"\";",
                    "goto": "qv"
                },
                {
                    "label": "Мне пора",
                    "goto": "end"
                }
            ]
        },
        "buy": "1.5|1200",
        "sell": "0.5|i.f.b.",
        "qv": {
            "text": "Дай гляну... Ух ты! Давненько я не встречал таких напитков. Это элексир Скоула, весьма интересная вещица. Впрочем, она интересна только нам- гномам, для остальных она не имеет надобности. Не буду тебе рассказывать чем интересен этот элексир, но могу за него не плохо заплатить.",
            "options": [
                {
                    "label": "Нет, спасибо.",
                    "goto": "end"
                },
                {
                    "label": "Что ты можешь мне предложить?",
                    "goto": "qvok"
                }
            ]
        },
        "qvok": {
            "text": "Могу предложить дублоны или скажем вино крепленое.",
            "options": [
                {
                    "label": "Давай вино",
                    "goto": "vino"
                },
                {
                    "label": "Давай дублоны",
                    "goto": "dub"
                },
                {
                    "label": "Нее, я передумал.",
                    "goto": "ruda"
                }
            ]
        },
        "vino": {
            "text": "eval: if(legacy_cmp(additem($loc,$login,\"\",\"i.q.hz\",\"count\"))>0) {additem($loc,$login,\"\",\"i.q.hz\",1); additem($loc,\"\",$login,\"i.f.b.kv\",10); $title_v=\"Отличная сделка!\";} else $title_v=\"\";",
            "options": [
                {
                    "label": "Ага. Удачи!",
                    "goto": "end"
                }
            ]
        },
        "dub": {
            "text": "eval: if(legacy_cmp(additem($loc,$login,\"\",\"i.q.hz\",\"count\"))>0) {additem($loc,$login,\"\",\"i.q.hz\",1); additem($loc,\"\",$login,\"i.q.dublon\",20); $title_v=\"Отличная сделка!\";} else $title_v=\"\";",
            "options": [
                {
                    "label": "Ага. Удачи!",
                    "goto": "end"
                }
            ]
        },
        "ruda": {
            "text": "Постой! Может тебя тогда руда устроит? много руды! Скажем 300 кусков?",
            "options": [
                {
                    "label": "Пожалуй я соглашусь",
                    "goto": "rudaok"
                },
                {
                    "label": "Нет",
                    "goto": "end"
                }
            ]
        },
        "rudaok": {
            "text": "eval: if(legacy_cmp(additem($loc,$login,\"\",\"i.q.hz\",\"count\"))>0) {additem($loc,$login,\"\",\"i.q.hz\",1); additem($loc,\"\",$login,\"i.ruda\",300); $title_v=\"Отличная сделка!\";} else $title_v=\"\";",
            "options": [
                {
                    "label": "Ага. Удачи!",
                    "goto": "end"
                }
            ]
        },
        "end": "Всего доброго тебе, заходи еще"
    }
}
