			if (legacy_cmp($skills[31])==0) msg("Ваш навык некроманта равен нулю, вы не умеете поднимать мертвых.");
			if (!$to) {
				$stmp="";
				foreach(array_keys((array)($l_i[$loc])) as $i) if (substr($i,0,10)=="i.s.d.n.c." || substr($i,0,10)=="i.s.d.n.a.") {
					$k=explode("|",$l_i[$loc][$i]);
