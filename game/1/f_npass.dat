if ($t) $s=trim($tmp[2]); else $s=time()+10;
$file = legacy_fopen_w ("online/".$login, "w");
if ($file!==false) {legacy_fputs($file,$loc."\n".time()."\n".$s);legacy_fclose($file);}

$login="";
