<?php
// перемещение в контактах
	$items=explode("|",$l_i[$loc][$login]["msg"]);
	if ($msg=="up") {
		for($i=0;$i<count((array)($items));$i++) if ($items[$i]==$id) break;
		if ($i==count((array)($items))) msg("Нет такого");
		if($i==0) {
			array_push($items, $items[$i]);
			array_shift($items);
			}else {
				$tc=$items[$i-1];
				$items[$i-1]=$items[$i];
				$items[$i]=$tc;
				}
		$l_i[$loc][$login]["msg"]=implode("|",(array)($items));
		msg("Пользователь передвинут вверх.");
		}
	if ($msg=="down") {
		for($i=0;$i<count((array)($items));$i++) if ($items[$i]==$id) break;
		if ($i==count((array)($items))) msg("Нет такого");
		if($i==count((array)($items))-1) {
			array_unshift($items, $items[$i]);
			array_pop($items);
			}else {
				$tc=$items[$i+1];
				$items[$i+1]=$items[$i];
				$items[$i]=$tc;
				}

		$l_i[$loc][$login]["msg"]=implode("|",(array)($items));
		msg("Пользователь передвинут вниз.");
		}
