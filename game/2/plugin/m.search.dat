<?php
// по всем соседним локаци€м
$arr=array();
for ($i=2;$i<count((array)($loc_c));$i+=2) if ($loc_c[$i+1]!=$loc){
	$arr[$loc_c[$i]]=array("na"=>0,"nc"=>0,"n"=>0,"u"=>0,"i"=>0,"uc"=>0,"ug"=>0);
	if (count((array)($l_i[$loc_c[$i+1]]))>0) {
		$keys=array_keys((array)($l_i[$loc_c[$i+1]]));
		foreach($keys as $j)
		if (substr($j,0,4)=='n.a.') $arr[$loc_c[$i]]["na"]+=1;
		else if (substr($j,0,4)=='n.c.') $arr[$loc_c[$i]]["nc"]+=1;
		else if (substr($j,0,2)=='n.') $arr[$loc_c[$i]]["n"]+=1;
		else if (substr($j,0,2)=='i.') $arr[$loc_c[$i]]["i"]+=1;
		else if (substr($j,0,2)=='u.') {
			$tchar=explode("|",$l_i[$loc_c[$i+1]][$j]);
			if ($tchar[8]) $arr[$loc_c[$i]]["ug"]+=1;
			else if ($tchar[9]) $arr[$loc_c[$i]]["uc"]+=1;
			else $arr[$loc_c[$i]]["u"]+=1;
			}

		}
	};
//print_r($arr);
// выводим
$sher="<p>¬ы чуствуете, что:";
foreach(array_keys((array)($arr)) as $i) {
	$sher.="<br/>".$i.": ";
	$b="";
	if ($arr[$i]["nc"]) {$sher.=$b.$arr[$i]["nc"]." монстров";$b=", ";}
	if ($arr[$i]["uc"]) {$sher.=$b.$arr[$i]["uc"]." преступников";$b=", ";}
	if ($arr[$i]["ug"]) {$sher.=$b.$arr[$i]["ug"]." призраков";$b=", ";}
	if ($arr[$i]["u"]) {$sher.=$b.$arr[$i]["u"]." игроков";$b=", ";}
	if ($arr[$i]["na"]) {$sher.=$b.$arr[$i]["na"]." животных";$b=", ";}
	if ($arr[$i]["n"]) {$sher.=$b.$arr[$i]["n"]." человек";$b=", ";}
	if ($arr[$i]["i"]) {$sher.=$b.$arr[$i]["i"]." предметов";$b=", ";}
	if (!$b) $sher.=" никого";
	}

msg($sher,"ѕоиск");
