<?php
// делаем луки из веток i.log

$arr=array(	// id, name_x, dificalt -%, count_logs, 
1=>array("i.w.r.b.detsk",	"детский лук",		0,	1),
2=>array("i.w.r.b.short",	"короткий лук",		10,	2),
3=>array("i.w.r.b.samod",	"самодельный лук",	20,	4),
4=>array("i.w.r.b.prochn",	"прочный лук",		40,	8),
5=>array("i.w.r.b.kach",	"качественный лук",	50,	12),
6=>array("i.w.r.b.master",	"лук мастера",		70,	20),
7=>array("i.w.r.b.veter",	"лук ветра",		97,	40),
);

$skills=explode("|",$l_i[$loc][$login]["skills"]);
function tsret($s) {if(legacy_cmp($s)>0) return $s; else return 0;}
if (!$to || !isset($arr[$to])) {
	$sher="Выберите что сделать:";
	foreach(array_keys((array)($arr)) as $i) $sher.="\n<br/><a href=\"$PHP_SELF?sid=$sid&use=$use&to=$i\">".$arr[$i][1]." (".$arr[$i][3]." веток, шанс: ".tsret(legacy_num($skills[27])*20-legacy_num($arr[$i][2]))."%)</a>";
	msg($sher);
	}

if (legacy_num($skills[27])*20-legacy_num($arr[$to][2])>0) {
	$char[6]=time()+15;
	$l_i[$loc][$login]["char"]=implode("|",(array)($char));

	additem($loc,$login,"","i.log",$arr[$to][3],"items","items",1,0,1);	// удаляем ветки
	additem($loc,$login,"","i.set.bow",1,"items","items",1,0,1);		// удаляем тетиву

	if (rand(0,100)<legacy_num($skills[27])*20-legacy_num($arr[$to][2])) {
		addjournal($loc,$login,"Вы сделали ".$arr[$to][1]); 
		addjournal($loc,"all",$char[0]." сделал ".$arr[$to][1],$login);
		additem($loc,"",$login,$arr[$to][0]."_".substr($login,2)."_",1);
		if (round(legacy_num(legacy_num($arr[$to][2])/10))) addexp($loc,$login,round(legacy_num(legacy_num($arr[$to][2])/10)));
		} else {
			addjournal($loc,$login,"Вы не смогли сделать ".$arr[$to][1]); 
			addjournal($loc,"all",$char[0]." не смог сделать ".$arr[$to][1],$login);
			}

} else addjournal($loc,$login,"Ваш навык плотника слишком низок, чтобы делать луки");
