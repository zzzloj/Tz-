<?php
// использование приемов
	if (!$fchar[9] && !$tchar[9] && $loc=='x1092x474' && $to!='u.ogir' && $from!='u.ogir') { addjournal($loc,$from,"В банке нельзя атаковать"); 
	return;
	}
		if (strpos($l_i[$loc][$login]["equip"],"i.w.r.")!==false) msg("Приемы можно использовать только в рукопашном бою или с холодным оружием ближнего боя");

		if (legacy_cmp($use[2])>0 && legacy_cmp($use[2])<10) {
			$tm=explode("|",$l_i[$loc][$login]["priem"]);
			$tc=intval($use[2])-1;
			if ($tm[$tc]) {$use=substr($tm[$tc],0,strpos($tm[$tc],":"));$l_i[$loc][$login]["macrol"]="use|$use|to|$to";} else msg("У вас нет приема под номером ".(legacy_num($tc)+1));
			}

		if (file_exists("items/".$use)) $priem=explode("|",implode("",(array)(file("items/".$use)))); else die("err: no items/".$use);
		if (strpos($l_i[$loc][$login]["priem"],$use.":")===false) msg("Вы не знаете прием ".$magic[0].", найдите NPC, который поможет его изучить.");
		if ($to==$login || !$to) msg("Нельзя применять прием к самому себе");

		// для боевых всегда нужна цель, для защитных не действует период
		if (substr($use,0,4)=="p.d." || substr($use,0,4)!="p.d." && isset($l_i[$loc][$to])) {
			if (substr($use,0,4)=="p.d." || time()>intval(preg_replace('/.*'.$use.':(\d+).*/',"\\1",$l_i[$loc][$login]["priem"]))) {
			$skills=explode("|",$l_i[$loc][$login]["skills"]);
			$war=explode("|",$l_i[$loc][$login]["war"]);
			// флаг
			if ($game["fid"]==$login && $game["floc"]==$loc) $war[0]= legacy_num($war[0]) + legacy_num(10);
			$ihit=(legacy_num($skills[2])-1)*10;	// штраф по интеллекту
			if($char[12]) $ihit= legacy_num($ihit) + legacy_num(10);	// штраф если на коне
			// боевой
			if (substr($use,0,4)!="p.d.") {
				// период
				$l_i[$loc][$login]["priem"]=preg_replace('/'.$use.':(\d+)/',$use.":".(time()+legacy_num($priem[1])),$l_i[$loc][$login]["priem"]);
				$magic=$war;
				$magic[0]= legacy_num($magic[0]) - legacy_num($ihit);

				if ($use=="p.b") {$magic[1]=round(legacy_num(legacy_num($magic[1])*0.7));$magic[2]=round(legacy_num(legacy_num($magic[2])*0.7)); $magic[3]=round(legacy_num(legacy_num($magic[3])*0.5));}
				if ($use=="p.d") {$magic[0]= legacy_num($magic[0]) - legacy_num(15);$magic[3]=-1;}
				if ($use=="p.me") {$magic[0]= legacy_num($magic[0]) - legacy_num(10);$magic[3]=-1;}
				if ($use=="p.m") {$magic[1]=round(legacy_num(legacy_num($magic[1])*0.7));$magic[2]=round(legacy_num(legacy_num($magic[2])*0.7));$magic[0]= legacy_num($magic[0]) + legacy_num(40);}
				if ($use=="p.n") {$magic[1]=round(legacy_num(legacy_num($magic[1])*0.6));$magic[2]=round(legacy_num(legacy_num($magic[2])*0.6));}
				if ($use=="p.r") {$magic[1]=round(legacy_num(legacy_num($magic[1])*0.4));$magic[2]=round(legacy_num(legacy_num($magic[2])*0.4));}
				if ($use=="p.vw") {$magic[1]=round(legacy_num(legacy_num($magic[1])*0.2));$magic[2]=round(legacy_num(legacy_num($magic[2])*0.2));}
				if ($use=="p.vs") {$magic[1]=round(legacy_num(legacy_num($magic[1])*0.2));$magic[2]=round(legacy_num(legacy_num($magic[2])*0.2));}
				if ($use=="p.g") {$magic[0]= legacy_num($magic[0]) - legacy_num(30);if (strpos($l_i[$loc][$login]["equip"],"i.w.")!==false) {$magic[1]= legacy_num($magic[1]) + legacy_num(legacy_num($skills[0])*2+legacy_num($skills[9]));$magic[2]= legacy_num($magic[2]) + legacy_num(legacy_num($skills[0])*2+legacy_num($skills[9]));} else {$magic[1]= legacy_num($magic[1]) + legacy_num(legacy_num($skills[0])+legacy_num($skills[8]));$magic[2]= legacy_num($magic[2]) + legacy_num(legacy_num($skills[0])+legacy_num($skills[8]));}}
				if ($use=="p.p") {$magic[0]= legacy_num($magic[0]) - legacy_num(20);if (strpos($l_i[$loc][$login]["equip"],"i.w.")!==false) $magic[2]= legacy_num($magic[2]) + legacy_num(legacy_num($skills[0])*3+legacy_num(legacy_num($skills[9]))*2); else $magic[2]= legacy_num($magic[2]) + legacy_num(legacy_num($skills[0])*2+legacy_num($skills[8]));}
				if ($use=="p.s") {$magic[0]= legacy_num($magic[0]) - legacy_num(10);if (strpos($l_i[$loc][$login]["equip"],"i.w.")!==false) $magic[2]= legacy_num($magic[2]) + legacy_num(legacy_num($skills[0])*2+legacy_num($skills[9])); else $magic[2]= legacy_num($magic[2]) + legacy_num(legacy_num($skills[0])+legacy_num($skills[8]));}

				if(legacy_cmp($magic[0])<1) $magic[0]=5;
				if(legacy_cmp($magic[0])>95) $magic[0]=95;
				if(legacy_cmp($magic[1])<0) $magic[1]=0;
				if(legacy_cmp($magic[2])<0) $magic[2]=0;

				attack($loc,$login,$to,implode("|",(array)($magic)),1,0,$use,$priem[0]);
				$char=explode("|",$l_i[$loc][$login]["char"]);
				if ($use=="p.d") {attack($loc,$login,$to,implode("|",(array)($magic)),1,0,$use,$priem[0]);$char=explode("|",$l_i[$loc][$login]["char"]); $char[6]=time()+legacy_num($war[3]);$l_i[$loc][$login]["char"]=implode("|",(array)($char));}
				if ($use=="p.me") {foreach($l_i[$loc] as $key=>$i) if($key!=$login && $key!=$to) {attack($loc,$login,$key,implode("|",(array)($magic)),1,0,$use,$priem[0]);} $char=explode("|",$l_i[$loc][$login]["char"]); $char[6]=time()+legacy_num(legacy_num($war[3]))*2;$l_i[$loc][$login]["char"]=implode("|",(array)($char));}

				// проверки на выбивание
				if (isset($l_i[$loc][$to])) {
					if ($l_i[$loc][$to]["def"]) $tdef=explode("|",$l_i[$loc][$to]["def"]); else $tdef=array(0,"","");
					if($use=="p.n") {if(rand(0,100)<=legacy_num($magic[0])-40 && ($tdef[0]!="p.d.n" || $tdef[0]=="p.d.n" && rand(0,100)>$tdef[3])) {addjournal($loc,$to,"Вас оглушили!"); addjournal($loc,"all",substr($to,2)." оглушен!",$to); $tc=explode("|",$l_i[$loc][$to]["char"]);$tc[6]=time()+15;$l_i[$loc][$to]["char"]=implode("|",(array)($tc));} if ($tdef[0]=="p.d.n") $l_i[$loc][$to]["def"]="";}
					if($use=="p.r") {if(rand(0,100)<=legacy_num($magic[0])-70 && ($tdef[0]!="p.d.r" || $tdef[0]=="p.d.r" && rand(0,100)>$tdef[3]) && strpos($l_i[$loc][$to]["equip"],"i.w.")!==false) {addjournal($loc,$to,"У вас выбито оружие!"); addjournal($loc,"all","У ".substr($to,2)." выбито оружие!",$to); additem($loc,$to,'loc',preg_replace('/.*?(i\.w\.[^\|]+).*/',"\\1",$l_i[$loc][$to]["equip"]),1,"items","items",1,-1,1); $tc=explode("|",$l_i[$loc][$to]["char"]);$tc[6]=time()+5;$l_i[$loc][$to]["char"]=implode("|",(array)($tc));}  if ($tdef[0]=="p.d.r") $l_i[$loc][$to]["def"]="";}
					if($use=="p.vw") {if(rand(0,100)<=legacy_num($magic[0])-40 && strpos($l_i[$loc][$to]["equip"],"i.a.s.")!==false) {addjournal($loc,$to,"У вас выбит щит!"); addjournal($loc,"all","У ".substr($to,2)." выбит щит!",$to); additem($loc,$to,'loc',preg_replace('/.*?(i\.a\.s\.[^\|]+).*/',"\\1",$l_i[$loc][$to]["equip"]),1,"items","items",1,-1,1); $tc=explode("|",$l_i[$loc][$to]["char"]);$tc[6]=time()+5;$l_i[$loc][$to]["char"]=implode("|",(array)($tc));}}
					if($use=="p.vs") {if(rand(0,100)<=legacy_num($magic[0])-50 && ($tdef[0]!="p.d.s" || $tdef[0]=="p.d.s" && rand(0,100)>$tdef[3])) {$tatk=1; require("plugin/m.kon.dat");}  if ($tdef[0]=="p.d.s") $l_i[$loc][$to]["def"]="";}
					}

				} else {	// защитные
					if ($use=="p.d.p" && strpos($l_i[$loc][$login]["equip"],"i.a.s.")===false) msg("Щит должен находиться у вас в руках");
					$l_i[$loc][$login]["def"]=$use."|".$priem[0]."|".(time()+legacy_num($priem[1]))."|".($use=="p.d.c"?legacy_num($skills[2])*16:(legacy_num($war[0])-legacy_num($ihit)));
					if ($use=="p.d.o") {$char[6]=time()+legacy_num($priem[1]);$l_i[$loc][$login]["char"]=implode("|",(array)($char));}
					}

			}else addjournal($loc,$login,"Период ".$priem[0]." не истек (еще ".(round(legacy_num((intval(preg_replace('/.*'.$use.':(\d+).*/',"\\1",$l_i[$loc][$login]["priem"]))-time())/60))+1)." минут)");
			}else addjournal($loc,$login,"Нет цели");
