            "item": "i.q.darklist"
          }
        ],
        "text": "Эй, смертный, что привело тебя в мой город? ",
        "options": [
          {
            "label": "Я пришел за заданием учитель, смотри на мне амулет темной власти.",
            "goto": "zad1",
            "if": [
              {
                "has": "i.a.m.vlast"
              }
            ]
          },
          {
            "label": "Я нашел потерянные листы из товоей книги.",
