				$tchar=explode("|",$npc["char"]);
				$tchar[0]=$title_v."-зомби";
				$tchar[2]=round(legacy_num(legacy_num($tchar[2])*0.7));
				if (legacy_cmp($tchar[2])<1) $tchar[2]=1;
				$tchar[1]=$tchar[2];
				$npc["char"]=implode("|",(array)($tchar));
				unset($npc["bank"]);
				unset($npc["osvej"]);
				unset($npc["equip"]);
				unset($npc["items"]);
				unset($npc["itemsrnd"]);
				$twar=explode("|",$npc["war"]);
				$twar[1]=round(legacy_num(legacy_num($twar[1])*0.7));
				if (legacy_cmp($twar[1])<0) $twar[1]=0;
				$twar[2]=round(legacy_num(legacy_num($twar[2])*0.7));
				if (legacy_cmp($twar[2])<0) $twar[2]=0;
				$twar[13]=0;
				unset($twar[15]);
				$npc["war"]=implode("|",(array)($twar));
				$tc=rand(300,legacy_num(300+(legacy_num($skills[31])+legacy_num($skills[2]))*90));
				$tc=time()+legacy_num($tc);
				$npc["owner"]=$login."|".$login."|".$login."|".$tc."|1";
