<?php
		if($char[8]) msg("Вы призрак, лошадь вас боится и не подпускает близко");
		if (!isset($l_i[$loc][$take])) msg("<p>Рядом нет этого коня");
		if($char[12]) msg("Вы и так на коне");
		if (!isset($l_i[$loc][$take]["owner"])) msg("Этот конь не приручен");
		$owner=explode("|",$l_i[$loc][$take]["owner"]);
		if ($owner[0]!=$login && $owner[1]!=$login) msg("Этот конь не принадлежит вам");
		$tc=explode("|",$l_i[$loc][$take]["char"]);
		$char[12]="1:".$tc[1];
		$char[6]=time()+3;
		$l_i[$loc][$login]["char"]=implode("|",(array)($char));
		calcparam($loc,$login);
		addjournal($loc,"all",$char[0]." сел на лошадь",$login);
		if (isset($l_i[$loc][$take]["name"])) $l_i[$loc][$login]["name"]=$l_i[$loc][$take]["name"];
		unset($l_i[$loc][$take]);
		msg("Вы сели на лошадь и теперь вы всадник");
