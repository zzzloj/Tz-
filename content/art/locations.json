{
  "_doc": "Location header art. rules: first regex (case-insensitive, on the location name before any «*[:#») that matches picks the art key; content/art/locations/<key>.webp. fallback: which key to show while a key's picture is not drawn yet. default: for names no rule matches.",
  "rules": [
    ["пыточн|темниц|камера \\d|подвал|погреб|подзем|катакомб|сокровищниц|тёмное помещение|завал", "loc-dungeon"],
    ["гробниц|пирамид|фараон|долина царей|бога ра|сэта|обелиск", "loc-pyramid"],
    ["пустын|пески|бархан|оазис", "loc-desert"],
    ["кладбищ|курган", "loc-graveyard"],
    ["орков|^орк|варвар|разбойник", "loc-orc-camp"],
    ["пират|шхуна|фрегат", "loc-pirate-fort"],
    ["остров|бухта", "loc-island"],
    ["эльф|старейшин", "loc-elves"],
    ["руин", "loc-ruins"],
    ["пещер|грот|рудник|шахт|берлог|ущель", "loc-cave"],
    ["гор[аы]?$|горах|предгорь|проход|перевал|водопад", "loc-mountains"],
    ["тронный|большой зал|малый +зал|парадный зал|замок, 2 этаж", "loc-castle-hall"],
    ["замок|оружейная|подъемный мост", "loc-castle"],
    ["крепост|цитадел|форт|аванпост|вышка|стена|сторожк", "loc-fortress"],
    ["обитель бога|храм|святилищ|молельн|монах", "loc-temple"],
    ["академи|гильди|библиотек|монстролог|башня мага", "loc-academy"],
    ["здание|казарм|ристалищ|рыцар|тренировоч|арена|капитоли", "loc-barracks"],
    ["таверн", "loc-tavern"],
    ["банк", "loc-bank"],
    ["магазин|кузнец|лекар|склад", "loc-shop"],
    ["конюш|загон", "loc-stable"],
    ["особняк|жилой|дом сорса|дом адула", "loc-city-houses"],
    ["дом|комнат|каморк|хранилищ|кладов|убежищ|землянк|этаж", "loc-house"],
    ["площад|колодец|двор$", "loc-city-square"],
    ["ворот|ворта", "loc-city-gate"],
    ["порт|пристан|причал|пирс", "loc-harbor"],
    ["улиц|переул|аллея|район|город|сад", "loc-city-street"],
    ["болот", "loc-swamp"],
    ["рек|мост|озер", "loc-river"],
    ["берег|побереж|пляж|море", "loc-coast"],
    ["березов|поляна|рощ|долин", "loc-forest-light"],
    ["лес|овраг|лесоповал|дерев", "loc-forest-pine"],
    ["дорог|тропа|тропин|развилка", "loc-road"]
  ],
  "fallback": {
    "loc-mountains": "loc-road",
    "loc-cave": "loc-forest-pine",
    "loc-dungeon": "loc-house",
    "loc-graveyard": "loc-forest-pine",
    "loc-orc-camp": "loc-forest-pine",
    "loc-fortress": "loc-city-gate",
    "loc-castle": "loc-city-gate",
    "loc-castle-hall": "loc-tavern",
    "loc-island": "loc-coast",
    "loc-pirate-fort": "loc-harbor",
    "loc-desert": "loc-road",
    "loc-pyramid": "loc-road",
    "loc-elves": "loc-forest-light",
    "loc-ruins": "loc-road"
  },
  "default": "loc-road"
}
