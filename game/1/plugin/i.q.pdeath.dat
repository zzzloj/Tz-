// урон всем вокруг по 150
	if ($loc=='x1092x474') msg("<p>В банке нельзя использовать порошок смерти");
	$war=explode("|",$l_i[$loc][$login]["war"]);
	$war[0]=100; $war[1]=0; $war[2]=90; $war[3]=10; $war[4]=0;  $war[12]="порошком смерти"; $war[14]=""; 
	$war=implode("|",(array)($war));

	$char[6]=time()+10;
	$l_i[$loc][$login]["char"]=implode("|",(array)($char));

	additem($loc,$login,"","i.q.pdeath",1,"items","items",1,0,1);
	if($loc=="x2375x934") addjournal($loc,"all","[громовой голос] КАК ТЫ СМЕЕШЬ МЕНЯ ТРЕВОЖИТЬ, ".strtoupper(substr($login,2))."?");

	foreach(array_keys((array)($l_i[$loc])) as $to) if (substr($to,0,2)!='i.' && $to!=$login) {
		attack($loc,$login,$to,$war,0,1);
		}
