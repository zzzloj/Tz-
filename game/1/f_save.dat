foreach(array_keys((array)($l_i[$loc])) as $j) if ($j!=$login) if ((substr($j,0,2)=='u.') || substr($j,0,2)=='n.') {$b=1; break;}
if (!$b) for ($i=2;$i<count((array)($loc_c));$i+=2) if ($loc_c[$i+1]!=$loc){
	if (count((array)($l_i[$loc_c[$i+1]]))>0) {
