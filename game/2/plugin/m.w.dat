<?php

function tsret($s) {if(legacy_cmp($s)>0) return $s; else return 0;}

$war=explode("|",$l_i[$loc][$login]["war"]);
if($loss) $war[0]=0; else $war[0]=100; $war[1]=tsret(legacy_num($magic[4])-10+legacy_num(legacy_num($skills[2]))*2); $war[2]=legacy_num($magic[5])+legacy_num(legacy_num($skills[2]))*2; $war[3]=$magic[8]; $war[4]=0;  $war[12]="магией"; $war[14]=""; 
$war=implode("|",(array)($war));

$arr=array();
if (substr($use,0,6)=="m.w.a.") {
	foreach(array_keys((array)($l_i[$loc])) as $to) if (substr($to,0,2)!='i.' && $to!=$login) $arr[$to]="";
	} else if (isset($l_i[$loc][$to]) && substr($to,0,2)!='i.') $arr[$to]="";


if (count((array)($arr))>0) {
$keys=array_keys((array)($arr));
foreach($keys as $to)  {
		$tchar=explode("|",$l_i[$loc][$to]["char"]);
		$tcrim=$tchar[9] || substr($to,0,4)=='n.c.';
		if ($use=='m.w.hit' && !$loss) {$heal=rand(legacy_num($magic[4]),legacy_num($magic[5])); $tchar[3]= legacy_num($tchar[3]) - legacy_num($heal); if(legacy_cmp($tchar[3])<0) $tchar[3]=0; $l_i[$loc][$to]["char"]=implode("|",(array)($tchar));}
		if ($use=='m.w.vamp' && !$tcrim) attack($loc,$login,$to,$war,0,1);
		else if (!$magic[7] || $magic[7] && $tcrim) attack($loc,$login,$to,$war,0,1);
		}

if ($use=='m.w.vamp' && !$loss) {	
	$tchar=explode("|",$l_i[$loc][$login]["char"]);
	if (!$tchar[8]) {
		$heal=rand(2,legacy_num($magic[4]));	// лечит
		if (legacy_num($tchar[1])+legacy_num($heal)>$tchar[2]) $heal=legacy_num($tchar[2])-legacy_num($tchar[1]);
		if (legacy_cmp($heal)>0) {$tchar[1]= legacy_num($tchar[1]) + legacy_num($heal); $l_i[$loc][$login]["char"]=implode("|",(array)($tchar)); addjournal($loc,$login,"Жизнь +".$heal);}
		}
	}
} else addjournal($loc,$login,"Заклинание не эффективно");
