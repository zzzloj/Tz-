<?php
		if (strpos($to,"_")!==false) $ti=substr($to,0,strpos($to,"_")); else
		if (strpos($to,"-")!==false) $ti=substr($to,0,strpos($to,"-")); else $ti=$to;
		if (substr($to,0,5)=="i.rr.") $item=explode("|","руна|50"); else if (file_exists("items1/".$ti)) $item=explode("|",implode("",(array)(file("items1/".$ti)))); else die("err: no items1/".$to);
		if (strpos($l_i[$loc][$speak]["bank"],$to.":")===false) msg("У меня нет ".$item[0]);
		$count=intval(preg_replace('/.*'.$to.':(\d+).*/',"\\1",$l_i[$loc][$speak]["bank"]));
		if ($count==0) msg($item[0]." у меня нет, попробуйте заглянуть в другой раз.",$tchar[0]);
		if ($count>1 && !$num) {		// кол-во
			$stmp="<p>Укажите количество:\n<br/><input name=\"num\" format=\"*N\" maxlength=\"7\" value=\"".$count."\"/>\n<br/><a href=\"$PHP_SELF?sid=$sid&speak=$speak&id=$id&to=$to&start=$start&num=$(num)\">Отправить</a>";
			msg($stmp,$tchar[0],1,"","num",$count);
			}
		if (!$num || $num<1) $num=1;
		if ($num>$count) $num=$count;
		// стоимость
		if ($item[1]<=1) $traders[0]=1;
		$price=round($item[1]*$num*$traders[0]);
		$dubl=intval(preg_replace('/.*i\.q.dublon:(\d+).*/',"\\1",$l_i[$loc][$login]["items"]));
		if ($dubl<$price) msg("У вас недостаточно денег (надо ".$price." дублонов)");
		additem($loc,$login,"","i.q.dublon",$price,"items","items",0,-1,1);
		additem($loc,$speak,$login,$to,$num,"bank","items",0,-1,1);
		msg("Вы купили ".$num." ".$item[0]." за ".$price." дублонов<br/><a href=\"$PHP_SELF?sid=$sid&speak=$speak&id=$id&start=$start\">Продолжить</a>");
