		if ($add) {$add=explode("|",$add); foreach($add as $i) {$i=explode(":",$i); $tc=additem($loc,$login,"",$i[0],"count","bank"); if ($tc<$i[1]) additem($loc,"",$login,$i[0],legacy_num($i[1])-legacy_num($tc),"items","bank");}}
