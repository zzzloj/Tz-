<?php

if ($to) {
	//if (strpos($to,"_")===false) msg("Затачивать можно только именные предметы, созданные игроками");
	if (strpos($to,"i.w.")===false) msg("Затачивать можно только оружие");
	if (strpos($to,"_")!==false) $tk=substr($to,0,strpos($to,"_")); else 
	if (strpos($to,"-")!==false) $tk=substr($to,0,strpos($to,"-")); else $tk=$to;
	if (file_exists("items/".$tk)) {$tirle_z_z=explode("|",implode("",file("items/".$tk))); $tirle_z_z=$tirle_z_z[0];} else die("no items/".$to); 
	if (intval(preg_replace('/.*'.$to.':(\d+).*/',"\\1",$l_i[$loc][$login]["items"]))<1) msg("У вас нет ".$tirle_z_z);
	$char[6]=time()+10;
	$za=explode('-',$to);
	$m=explode('..',$to);
	$v=explode('-',$m[0]);
	if (!$za[1]) { $zx='1';  } else { $zx=$za[1]+1; }

	if (rand(1,$zx*$zx+22)<12) {
		additem($loc,$login,"",$to,1);
		additem($loc,$login,"",$use,1);
		if ($m[1]) {
		$k="..".$m[1];
		for ($i=2; $i<count($m); $i++) {
		$k.="..".$m[$i];
		}
		}
		if (!$za[1]) $za[1]=0;
		$za[1]++;

		$to=$v[0]."-".$za[1]."-".$k;
		addjournal($loc,$login,"Вы заточили ".$tirle_z_z." до +".$za[1]);
		addjournal($loc,"all",$char[0]." заточил ".$tirle_z_z." до +".$za[1],$login);
		additem($loc,"",$login,$to,1);

	} else { 
		additem($loc,$login,"",$use,1);
		additem($loc,$login,"",$to,1);
		addjournal($loc,$login,"Вы не смогли заточить оружие");
		addjournal($loc,"all",$char[0]." не смог заточить оружие",$login);
	       }
	
	
} else $list='all';