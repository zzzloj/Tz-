<?php

$rnd=rand(0,100);
if (legacy_cmp($rnd)<=20) 		 $id="i.f.apple";
if (legacy_cmp($rnd)>20 && legacy_cmp($rnd)<=35) $id="i.f.cabbage"; 
if (legacy_cmp($rnd)>35 && legacy_cmp($rnd)<=55) $id="i.f.bread";
if (legacy_cmp($rnd)>55 && legacy_cmp($rnd)<=75) $id="i.f.sandwich";
if (legacy_cmp($rnd)>75 && legacy_cmp($rnd)<=85) $id="i.f.mushroom";
if (legacy_cmp($rnd)>85 && legacy_cmp($rnd)<=100) $id="i.f.sausage";
// добавляем в локацию
additem($loc,"","loc",$id,1);