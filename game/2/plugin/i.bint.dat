<?php
// бинт лечит до 5-5+skill*2 пунктов, но иногда срывается, после использования пропадают (FIX: в будущем пачкаются и можно мыть)


$skills=explode("|",$l_i[$loc][$login]["skills"]);
if (legacy_cmp($skills[22])>0) {
	$char[6]=time()+5;
	$l_i[$loc][$login]["char"]=implode("|",(array)($char));
	additem($loc,$login,"","i.bint",1);	

	if (rand(1,100)<40+legacy_num(legacy_num($skills[22]))*10) {
		$heal=rand(5,legacy_num(5+legacy_num(legacy_num($skills[22]))*2));
		if (legacy_num($char[1])+legacy_num($heal)>$char[2]) $heal=legacy_num($char[2])-legacy_num($char[1]);
		$char[1]= legacy_num($char[1]) + legacy_num($heal);
		$l_i[$loc][$login]["char"]=implode("|",(array)($char));
		addjournal($loc,$login,"Жизнь +".$heal);

		addjournal($loc,$login,"Вы забинтовываете раны"); 
		addjournal($loc,"all",$char[0]." забинтовывает раны",$login);
		} else {
			addjournal($loc,$login,"Вы не смогли забинтовать раны"); 
			addjournal($loc,"all",$char[0]." не смог забинтовать раны",$login);
			}

} else addjournal($loc,$login,"Ваш навык лекаря равен 0, вы не умеете пользоваться бинтами");
