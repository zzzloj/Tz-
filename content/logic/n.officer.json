          },
          {
            "label": "Я хочу посмотреть список кого разыскивают",
            "goto": "stat"
          },
          {
            "label": "Что-то скучно...",
            "goto": "hum"
          },
          {
            "label": "Ничего особенного, мне пора",
            "goto": "end"
          }
        ]
      }
    ],
