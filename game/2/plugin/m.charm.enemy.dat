<?php

// привлечь на свою до 20 сек - 1 минута сторону любого (кроме гардов) атакующего, защищает, но не сопровождает
if (isset($l_i[$loc][$to]) && substr($to,0,2)=='n.' && !substr($to,0,4)=='n.g.') {
	if (isset($l_i[$loc][$to]["owner"])) msg("Этот персонаж принадлежит другому");
	$tchar=explode("|",$l_i[$loc][$to]["char"]);
	if ($tchar[7]) {
		$tchar[7]="";
		$l_i[$loc][$to]["char"]=implode("|",(array)($tchar));
		$l_i[$loc][$to]["owner"]=$login."|0|".$login."|".(time()+rand(20,legacy_num(1*60)))."|0";
		} else addjournal($loc,$login,"Заклинание действует только на дерущихся");
	} addjournal($loc,$login,"Заклинание на него не подействует");
