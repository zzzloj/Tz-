{
  "id": "n.castleguard",
  "topics": {
    "begin": [
      {
        "options": [
          {
            "label": "Ты что не видишь, что я один из стражников барона Дитриха?",
            "goto": "gr",
            "if": [
              {
                "has": "i.q.ditrih"
              }
            ]
          },
          {
            "label": "Меня зовут <imja> и у меня нет никаких грамот.",
            "goto": "v1",
            "if": [
              {
                "lacks": "i.q.ditrih"
              }
            ]
          },
          {
            "label": "А что, просто так пройти нельзя?",
            "goto": "v2"
          },
          {
            "label": "Мое имя может стать последним, что ты услышишь, смерд!",
            "goto": "v3"
          },
          {
            "label": "[молча развернуться и уйти]",
            "goto": "end"
          }
        ]
      }
    ],
    "gr": [
      {
        "if": [
          {
            "has": "i.q.ditrih"
          }
        ],
        "do": [
          {
            "teleport": "x902x254"
          }
        ],
        "text": "Извини, <imja>. Проходи, разумеется."
      },
      {
        "text": "Не вижу на тебе ленты стражника, что ты несешь?"
      }
    ],
    "vnow": [
      {
        "do": [
          {
            "take": "i.money",
            "count": 400
          },
          {
            "teleport": "x902x254"
          }
        ],
        "text": "Хорошо, проходи. Но помни, что внутри есть вооруженная охрана, так что не делай глупостей!"
      }
    ]
  }
}