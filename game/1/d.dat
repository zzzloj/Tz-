$s=$blog_text;
	// UTF-8 русские буквы
	$s=str_replace("\xd0\x81","Ё",$s);
	$s=str_replace("\xd1\x91","ё",$s);
	$s=preg_replace_callback("/\xd0([\x90-\xbf])/",function ($m) { return chr(legacy_num(ord($m[1])+48)); },$s);
	$s=preg_replace_callback("/\xd1([\x80-\x8f])/",function ($m) { return chr(legacy_num(ord($m[1])+112)); },$s);

	$s=str_replace('\\',"",$s);
	$s=str_replace('"',"",$s);
	$s=str_replace("'","",$s);
	$s=preg_replace('/([^ -}А-яЁё#])|\$|&/',"",$s);
	$s=preg_replace('/(с|c)(у|y)(ч)?(к|k)(а|a)/i',"[бип]",$s);
	$s=preg_replace('/пидор/i',"[бип]",$s);
	$s=preg_replace('/пид(о|o|a|а)(р|p)(а|a)(з|c|с)/i',"[бип]",$s);
	$s=preg_replace('/\w*(х|x)(у|y)\w*/i',"[бип]",$s);
	$s=preg_replace('/\w*пизд\w*/i',"[бип]",$s);
	$s=preg_replace('/\w*(е|e)б(а|a)\w*/i',"[бип]",$s);
	$s=preg_replace('/\w*бля\w*/i',"[бип]",$s);
	$s=str_replace("|","",$s);
	$s=str_replace("<","",$s);
	$s=str_replace(">","",$s);
$blog_text=substr($s,0,350);
list($prevblog_text)=mysql_fetch_array(mysql_query("select text from blogs where userid='".$clan."';",$link));
if(!empty($blog_text) && $blog_text!=$prevblog_text  && legacy_cmp(mysql_num_rows(mysql_query("select id from blogs where userid='".$clan."' and text='$blog_text' and time>".(time()-300).";")))<1)
{
