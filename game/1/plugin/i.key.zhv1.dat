<?php

// открывает и запирает дверь в комнате в таверне, измен€€ файл с выходами c.5.hran
// записи о посетител€х хран€тс€ в c.5.sklad у n.Valor в tav=user:time:pass|user:time:pass|user:time:pass|user:time:pass
// к закрытым двер€м приписываем [закрыто] и ссылку замен€ем на самого себ€

loadloc("c.5.sklad");
if ($loc!="c.5.hran" && $loc!="c.5.x1087x543") msg("¬ы должны быть в своем хранилище");
if (!isset($l_i["c.5.sklad"]["n.Valor"])) msg("’ранител€ нет на месте, пока он не по€витс€, вы не можете использовать ключ");

if (strpos($l_i["c.5.sklad"]["n.Valor"]["tav"],$login.":")!==false) {
	// загружаем статус дверей
	$tc=array(0,0,0,0);	// какие закрыты
	if (strpos($l_tt["c.5.hran"]["d"],"c.5.x1087x543")===false) $tc[0]=1;
	if (strpos($l_tt["c.5.hran"]["d"],"c.5.x1080x539")===false) $tc[1]=1;
	if (strpos($l_tt["c.5.hran"]["d"],"c.5.x1080x532")===false) $tc[2]=1;
	if (strpos($l_tt["c.5.hran"]["d"],"c.5.x1087x528")===false) $tc[3]=1;

	// проверим, не вышло ли врем€
	$t=intval(preg_replace('/.*'.$login.':(\d+).*/',"\\1",$l_i["c.5.sklad"]["n.Valor"]["tav"]));
	$tav=explode("|",$l_i["c.5.sklad"]["n.Valor"]["tav"]);
	$tr=explode(":",$tav[0]);
	if (time()<$t) {
		if ($tr[0]!=$login) msg("Ёто не ваше хранилище");
		$tc[0]=!$tc[0];
		if (!$tc[0]) {
			addjournal($loc,$login,"¬ы открыли дверь в хранилище 1");
			addjournal($loc,"all",$char[0]." открыл дверь в хранилище 1",$login);
			}else {
				addjournal($loc,$login,"¬ы заперли дверь в хранилище 1");
				addjournal($loc,"all",$char[0]." запер дверь в хранилище 1",$login);
				if ($game["floc"]==$loc) {unset($l_i[$loc]["i.flag"]); $l_i["c.5.hran"]["i.flag"]="флаг лидерства|1|0"; $game["floc"]="c.5.hran"; $tl=$game["fid"]; $game["fid"]=""; if (isset($l_i[$loc][$tl])) {calcparam($loc,$tl); if($tl==$login) $char=explode("|",$l_i[$loc][$login]["char"]);}}
				}

		}else{	// открываем дверь, удал€ем юзера
			$tc[0]=0;
			$tav[0]="";
			$l_i["c.5.sklad"]["n.Valor"]["tav"]=implode("|",$tav);
			addjournal($loc,$login,"—рок аренды кончилс€");
			}

	// сохран€ем новый файл
	$new="’ранилище|0|в кладовую|c.5.sklad";

	$new.="|дверь в хранилище 1";
	if ($tc[0]) $new.=" [закрыто]|c.5.hran"; else $new.="|c.5.x1087x543";
	$new.="|дверь в хранилище 2";
	if ($tc[1]) $new.=" [закрыто]|c.5.hran"; else $new.="|c.5.x1080x539";
	$new.="|дверь в хранилище 3";
	if ($tc[2]) $new.=" [закрыто]|c.5.hran"; else $new.="|c.5.x1080x532";
	$new.="|дверь в хранилище 4";
	if ($tc[3]) $new.=" [закрыто]|c.5.hran"; else $new.="|c.5.x1087x528";

	$l_tt["c.5.hran"]["d"]=$new;
	$loc_c = explode("|",$l_tt[$loc]["d"]);
	$l_tt["c.5.hran"]["save"]=1;

	} else addjournal($loc,$login," люч не подходит ни к одной двери");
