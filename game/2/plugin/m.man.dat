<?php
// увеличивает макс. Ману цели на int*2

if (isset($l_i[$loc][$to]) && substr($to,0,2)=='u.') {
	$tchar=explode("|",$l_i[$loc][$to]["char"]);
	$tskills=explode("|",$l_i[$loc][$to]["skills"]);
	$skills=explode("|",$l_i[$loc][$login]["skills"]);
	$tchar[4]=10+$tskills[2]*10+$skills[2]*2;
	if (strpos($l_i[$loc][$to]["equip"],"..ma")!==false) $tchar[4]+=10;
	if (strpos($l_i[$loc][$to]["equip"],"..ne")!==false) $tchar[4]-=20;

	$tchar[5]=time();
	$l_i[$loc][$to]["char"]=implode("|",$tchar);
	addjournal($loc,$to,"Макс.мана +".($skills[2]*2));
	if ($to!=$login) addjournal($loc,$login,$tchar[0].": макс.мана +".($skills[2]*2));
	} else addjournal($loc,$login,"Действует только на людей");
