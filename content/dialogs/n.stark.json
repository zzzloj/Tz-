{
    "id": "n.stark",
    "topics": {
        "begin": {
            "text": "Стой,ты кто и что тебе надо в храме великого Сэта?",
            "options": [
                {
                    "label": "А какое тебе дело?",
                    "goto": "st1"
                },
                {
                    "label": "А ты кто такой?",
                    "goto": "who"
                },
                {
                    "label": "Ладно пойду я",
                    "goto": "end"
                }
            ]
        },
        "end": "Ладно, пока. Будь осторожен.",
        "who": {
            "text": "Я один из его слуг,правда не очень то мне нравится ему служить но что сделать,приходится",
            "options": [
                {
                    "label": "Почему приходится?",
                    "goto": "st2"
                },
                {
                    "label": "Ну служи,служи",
                    "goto": "end"
                }
            ]
        },
        "st1": {
            "text": "Мне? хехе да впринципе никакого просто если ты не поклоняешься Сэту то ты труп",
            "options": [
                {
                    "label": "понятненько",
                    "goto": "begin"
                },
                {
                    "label": "Ясно,спасибо что предупредил",
                    "goto": "end"
                }
            ]
        },
        "st2": {
            "text": "А что я могу сделать? он все наши земли заполнил нежитью и убил почти всех поклонников бога Ра",
            "options": [
                {
                    "label": "Но хоть кто то остался?",
                    "goto": "st3"
                }
            ]
        },
        "st3": {
            "text": "Да тут не далеко остался один храм но даж не знаю остался ли кто там",
            "options": [
                {
                    "label": "Ясно спасибо",
                    "goto": "end"
                }
            ]
        }
    }
}
