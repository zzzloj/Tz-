<!-- The map plan (Assets/Tz/Editor/TzWorld.cs) without Unity: prints its numbers and writes plan-N.json,
     which draw.py turns into a picture. From the repository root: dotnet run, project mmo/tools/world; then draw.py -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <RestoreSources>none</RestoreSources>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Tz/Scripts/Rules/TzJson.cs" />
    <Compile Include="../../Assets/Tz/Editor/TzWorld.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
