# Unity makes these on every open and build.
/Library/
/Temp/
/Logs/
/obj/
/Build/
/build/
/UserSettings/
*.csproj
!/tools/check/check.csproj
*.sln
# Pictures and fonts are copied from content/art and engine/iosApp by tools/prepare.py before a build.
/Assets/Resources/Art/
/Assets/Resources/Fonts/
/Assets/Resources/Art.meta
/Assets/Resources/Fonts.meta
/Assets/Resources/Data/
/Assets/Resources/TopDown/
/Assets/Resources/TopDown.meta
/Assets/Resources/Data.meta
/Assets/Icons/
/Assets/Icons.meta
/Assets/Scenes/
/Assets/Scenes.meta
# The compile check against stubs (tools/check) keeps its own build output.
/tools/check/bin/
/tools/check/obj/
