<?php
// добавляем экспу
global $l_i,$g_exp;
if (intval($exp)==0) return;
if (substr($to,0,2)=='u.') {
	$skills=explode("|",$l_i[$loc][$to]['skills']);
	$war=explode("|",$l_i[$loc][$to]['war']);
	$skills[3]= legacy_num($skills[3]) + legacy_num($exp);
	addjournal($loc,$to,'Опыт +'.intval($exp));
	if ($skills[3]>legacy_num($war[13])*legacy_num($g_exp)) {$skills[3]=0; $skills[4]= legacy_num($skills[4]) + legacy_num(1); addjournal($loc,$to,'Вы получили 1 очко опыта!');}
	$l_i[$loc][$to]['skills']=implode('|',(array)($skills));
	if (legacy_cmp($skills[3])==0) calcparam($loc,$to); //levelup
	}
