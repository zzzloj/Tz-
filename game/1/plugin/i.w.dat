<?php
			$equip=$l_i[$loc][$login]["equip"];
			// если в руках нож и есть $to, то освежевание
			if ($to && substr($use,0,6)=='i.w.k.') {
				include "plugin/i.w.k.dat";
				}else // рубка деревьев
			if ($to && substr($use,0,6)=='i.w.t.') {
				include "plugin/i.w.t.dat";
				}else {
				if (strpos($use,"_")!==false) $ti=substr($use,0,strpos($use,"_")); else
				if (strpos($use,"-")!==false) {$ti=substr($use,0,strpos($use,"-"));} else $ti=$use;
				
				 if(eregi("i.a.s.", $equip)) $shit="1";
				 if(eregi("i.w.r.", $equip)) $luk="1";
				if (strpos($equip,$ti)===false) {	// одеваем
					if (substr($use,0,4)=='i.w.' && substr($use,0,6)!='i.w.r.') { 
						if (strpos($equip,"i.w.")===false) {if (!$equip) $equip=$use; else if ($equip[strlen($equip)-1]=="|") $equip.=$use; else $equip.="|".$use;}
							else {$equip=preg_replace('/i\.w\.[^|]+/',$use,$equip);}
					} 
						//////////////////////////////////////
						else if (substr($use,0,6)=='i.w.r.' && $shit!="1") {
						if (strpos($equip,"i.w.")===false) {if (!$equip) $equip=$use; else if ($equip[strlen($equip)-1]=="|") $equip.=$use; else $equip.="|".$use;}
							else {$equip=preg_replace('/i\.w\.[^|]+/',$use,$equip);}
					} 
					if (substr($use,0,4)=='i.a.' && substr($use,0,6)!='i.a.s.') { 
						if (strpos($equip,substr($use,0,6))===false) {if (!$equip) $equip=$use; else if ($equip[strlen($equip)-1]=="|") $equip.=$use; else $equip.="|".$use;}
							else {$equip=preg_replace('/'.substr($use,0,6).'[^|]+/',$use,$equip);}
						//////////////////////////////////////
						} else if (substr($use,0,6)=='i.a.s.' && $luk!="1") { 
						if (strpos($equip,substr($use,0,6))===false) {if (!$equip) $equip=$use; else if ($equip[strlen($equip)-1]=="|") $equip.=$use; else $equip.="|".$use;}
							else {$equip=preg_replace('/'.substr($use,0,6).'[^|]+/',$use,$equip);}
					} } else $equip=preg_replace('/'.$ti.'[^|]*\|?/',"",$equip);
				$l_i[$loc][$login]["equip"]=$equip;
				calcparam($loc,$login);
				if (!$list) $list='inv';	// только если не взяли нож
				}
