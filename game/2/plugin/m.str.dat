<?php
// увеличивает макс. жизнь цели на int*2

if (isset($l_i[$loc][$to]) && substr($to,0,2)=='u.') {
	$tchar=explode("|",$l_i[$loc][$to]["char"]);
	$tskills=explode("|",$l_i[$loc][$to]["skills"]);
	$skills=explode("|",$l_i[$loc][$login]["skills"]);
	$tchar[2]=10+legacy_num(legacy_num($tskills[0]))*10+legacy_num(legacy_num($skills[2]))*2;
	if ($game["fid"]==$to && $game["floc"]==$loc) $tchar[2]= legacy_num($tchar[2]) + legacy_num(10);
	if (strpos($l_i[$loc][$to]["equip"],"..am")!==false) $tchar[2]= legacy_num($tchar[2]) + legacy_num(5);
	if (strpos($l_i[$loc][$to]["equip"],"..ne")!==false) $tchar[2]= legacy_num($tchar[2]) + legacy_num(10);
	if (strpos($l_i[$loc][$to]["equip"],"..on")!==false) $tchar[2]= legacy_num($tchar[2]) - legacy_num(10);
	$tchar[5]=time();
	$l_i[$loc][$to]["char"]=implode("|",(array)($tchar));
	addjournal($loc,$to,"ћакс.жизнь +".(legacy_num($skills[2])*2));
	if ($to!=$login) addjournal($loc,$login,$tchar[0].": макс.жизнь +".(legacy_num($skills[2])*2));
	} else addjournal($loc,$login,"ƒействует только на людей");
