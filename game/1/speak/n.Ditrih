'rab2'=>'Хорошо. Тогда слушай. Я хочу узнать что замышляют орки. Для этого мне нужны дневники их предводителей.#А где мне найти этих орков?#inf#Я добуду их!#end',
'spec'=>'eval: if(legacy_cmp(additem($loc,$login,"","i.q.dle","count"))>0 && legacy_cmp(additem($loc,$login,"","i.q.dkap","count"))>0 && legacy_cmp(additem($loc,$login,"","i.q.dma","count"))>0) {additem($loc,$login,"","i.q.dle",1); additem($loc,$login,"","i.q.dkap",1); additem($loc,$login,"","i.q.dma",1); additem($loc,"",$login,"i.a.d.msl",1);additem($loc,"",$login,"i.f.b.kv",10); addexp($loc,$login,100); $title_v="Ты выполнил задание. За это я награждаю тебя этим орденом. Возьми еще немного вина, чтоб ты мог отпразнывать свой успех.";} else $title_v="";#Спасибо, всегда рад помочь!.#end',
