// увеличивает броню цели на int

if (isset($l_i[$loc][$to]) && substr($to,0,2)=='u.') {
	if ($to!="u.ascorun" && $to!="u.askorun") { calcparam($loc,$to); }	// чтобы постоянно не увеличивать каждый раз, сбивает эффект заклинания Сила
	$twar=explode("|",$l_i[$loc][$to]["war"]);
	$skills=explode("|",$l_i[$loc][$login]["skills"]);

	$twar[5]= legacy_num($twar[5]) + legacy_num($skills[2]);
	$l_i[$loc][$to]["war"]=implode("|",(array)($twar));
	addjournal($loc,$to,"Броня +".$skills[2]);
	if ($to!=$login) addjournal($loc,$login,$tchar[0].": броня +".$skills[2]);
	} else addjournal($loc,$login,"Действует только на людей");
