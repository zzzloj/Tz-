<?php
// приемы
	// проверки
	if (strpos($l_i[$loc][$login]["priem"],$skill.":")!==false) msg("<p>Вы уже знаете этот прием",$tchar[0]);
	if ($cost) {
		$money=intval(preg_replace('/.*i\.money:(\d+).*/',"\\1",$l_i[$loc][$login]["items"]));
		if ($money<$cost) msg("<p>У вас недостаточно денег (надо ".$cost." монет)",$tchar[0]);
		additem($loc,$login,"","i.money",$cost,"items","items",1,-1,1);
		}
	if (!$l_i[$loc][$login]["priem"]) $l_i[$loc][$login]["priem"]=$skill.":1"; else $l_i[$loc][$login]["priem"].="|".$skill.":1";
	msg("<p>Вы выучили новый прием!",$tchar[0]);
