<?php

	$stmp="<b>Замок Луен</b>:";
	$tmp=unserialize(implode("",(array)(file("l_i/c.3.gate"))));
	if ($tmp["d"]) {
		$d=explode("|",$tmp["d"]);
		if (strpos($d[0],"*")===false) $clanc=""; else $clanc=substr($d[0],legacy_num(strpos($d[0],"*")+1),legacy_num(strrpos($d[0],"*")-strpos($d[0],"*")-1));
		if ($clanc) $stmp.=" принадлежит клану ".$clanc; else $stmp.=" никому не принадлежит";
		} else $stmp.=" [ошибка загрузки]";

