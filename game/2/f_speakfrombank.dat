<?php
	if ($up || $down) include "f_speakfrombankm.dat";

	if ($speak=="n.t.bankir" && $char[14]!="t") msg("Извини, услуги банка только для вступивших в Орден Тамплиера.");
	if ($speak=="n.p.bankir" && $char[14]!="p") msg("Ха, ты не не один из нас. Вначале стань настоящим пиратом, тогда и поговорим.");
//	require "f_time.dat";
//	if ($time >= 08.00 and $time < 20.00) $z=1;  
//	if ($time >= 00.00 and $time <= 08.00) $z=2;
//	if ($time >= 16.00 and $time <= 23.59) $z=3;
//	if ($z!=1 && $speak=="n.bankir") msg("Извини, но банк работает только с восьми утра и до восьми вечера!");
//	if ($z!=2 && $speak=="n.p.bankir") msg("Мы пираты, и банк работает только ночью!");
//	if ($z!=3 && $speak=="n.t.bankir") msg("Извини, но банк работает только с восьми утра и до пяти вечера!");
	// список
	$items=explode("|",$l_i[$loc][$login]["bank"]);
	if (!$items) msg("У вас в банке нет ни одного предмета",$tchar[0]);
	$stmp="";
	if (!$start) $start=0;
	$keys=array_keys((array)($items));
	for ($i=$start;$i<legacy_num($start)+legacy_num($g_list) && $i<count((array)($keys));$i++) if ($items[$keys[$i]]){
		$k=explode(":",$items[$keys[$i]]);
		if (strpos($k[0],"_")!==false) $ti=substr($k[0],0,strpos($k[0],"_")); else
		if (strpos($k[0],"-")!==false) $ti=substr($k[0],0,strpos($k[0],"-")); else $ti=$k[0];
		if (substr($k[0],0,5)=="i.rr.") $item=explode("|","руна|50"); else if (file_exists("items/".$ti)) $item=explode("|",implode("",(array)(file("items/".$ti)))); else die("err: no items/".$k[0]);
		$item=$item[0];
		
		if (substr($k[0],0,5)=="i.rr." && $k[0]!="i.rr.empty") { loadloc(substr($k[0],5)); $tt=explode("|",$l_tt[substr($k[0],5)]["d"]); if (strpos($tt[0],"*")!==false) $tt[0]=substr($tt[0],0,strpos($tt[0],"*")); $item.=" [".$tt[0]."]"; }
		
		if (strpos($k[0],"..")!==false) $item.=" *";
		if (legacy_cmp($k[1])>1) $item.=" (".$k[1].")";
		$stmp.="\n<br/><anchor>".$item."<go href=\"#menu\"><setvar name=\"to\" value=\"".$k[0]."\"/></go></anchor>";
		}
	if ($stmp) $stmp="<p>Выберите предмет:".$stmp; else msg("У вас в банке нет ни одного предмета",$tchar[0]);
	if ($start) {$stmp.= "\n<br/><a href=\"$PHP_SELF?sid=$sid&speak=$speak&id=$id\">^ </a>";}
	if (legacy_num($start)+legacy_num($g_list)<count((array)($keys))) {if (!$start) $stmp.="\n<br/>"; $stmp.= "<a href=\"$PHP_SELF?sid=$sid&speak=$speak&id=$id&start=".(legacy_num($start)+legacy_num($g_list))."\">+ (".(count((array)($keys))-legacy_num(legacy_num($start))-legacy_num($g_list)).")</a>";}
	$stmp.="\n</p>\n</card>\n<card id=\"menu\" title=\"Меню\">\n<p>\n<a href=\"$PHP_SELF?sid=$sid&speak=$speak&id=$id&start=$start&to=$(to)\">Забрать из банка</a>\n<br/><a href=\"$PHP_SELF?sid=$sid&look=$(to)\">Инфо</a>\n<br/><a href=\"$PHP_SELF?sid=$sid&speak=$speak&id=$id&up=$(to)\">[Вверх</a> | <a href=\"$PHP_SELF?sid=$sid&speak=$speak&id=$id&down=$(to)\">Вниз</a>]";
	msg($stmp,$tchar[0]);
