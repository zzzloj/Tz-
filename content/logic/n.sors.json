{
  "id": "n.sors",
  "topics": {
    "begin": [
      {
        "options": [
          {
            "label": "Кто ты?",
            "goto": "who"
          },
          {
            "label": "Ты чем-нибудь торгуешь?",
            "goto": "ask"
          },
          {
            "label": "Тебе случаем кокан черного шелкопряда не нужен?",
            "goto": "qv",
            "if": [
              {
                "has": "i.q.chsh"
              }
            ]
          },
          {
            "label": "Можешь научить меня своей профессии?",
            "goto": "weaver"
          },
          {
            "label": "Не надо приветствий, я уже ушел...",
            "goto": "end"
          }
        ]
      }
    ],
    "qv": [
      {
        "options": [
          {
            "label": "Давай прялку",
            "goto": "prjal"
          },
          {
            "label": "Нет, спасибо...",
            "goto": "end"
          },
          {
            "label": "Шуба? Думаю, моей спутнице она понравится. давай ее сюда.",
            "goto": "qv2",
            "if": [
              {
                "has": "i.q.chsh"
              }
            ]
          }
        ]
      }
    ],
    "qv2": [
      {
        "if": [
          {
            "has": "i.q.chsh"
          }
        ],
        "do": [
          {
            "take": "i.q.chsh"
          },
          {
            "give": "i.a.r.shubl"
          }
        ],
        "text": "Отличная сдека! Думаю, твой подарок обязательно оценят."
      }
    ],
    "prjal": [
      {
        "if": [
          {
            "has": "i.q.chsh"
          }
        ],
        "do": [
          {
            "take": "i.q.chsh"
          },
          {
            "give": "i.set.prjal"
          }
        ],
        "text": "Вот. Надеюсь пользоваться ты ей умеешь."
      }
    ]
  }
}
