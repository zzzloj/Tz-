'begin'=>'Кто ты и что тебе надо?#Меня зовут <imja>, а вы кто?#who#Много чести для тебя знать мое имя#end1#Я хочу поступить к вам на службу#qv#eval: if(legacy_cmp(additem($loc,$login,"","i.q.dle","count"))>0 && legacy_cmp(additem($loc,$login,"","i.q.dkap","count"))>0 && legacy_cmp(additem($loc,$login,"","i.q.dma","count"))>0) $title_v="Я принес дненики орков."; else $title_v="";#spec#Я собираюсь в Ансалон, вы можете дать мне отряд воинов?#go#Вообще-то мне пора#end',
