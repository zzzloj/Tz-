              {
                "skill": "currier",
                "max": 0
              }
            ]
          },
          {
            "label": "Я хочу купить инструмент для изготовления доспехов из шкур",
            "goto": "shk",
            "if": [
              {
                "skill": "currier",
                "min": 1
              }
            ]
          },
