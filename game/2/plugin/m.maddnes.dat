<?php

if ($l_i[$loc]) {
	$keys = array_keys((array)($l_i[$loc]));
	$id = $keys[rand(0,count((array)($keys))-1)];
	if ($loc_c[1]==1 && rand(0,100)<80) {
		$id=$login;
		docrim($loc,$login,"провокатор");
		}
	if ((substr($id,0,2)=='u.' || substr($id,0,2)=='n.') && substr($id,0,4)!='n.g.') {
		$idto = $keys[rand(0,count((array)($keys))-1)];
		if ($id!=$idto && (substr($idto,0,2)=='u.' || substr($idto,0,2)=='n.') && substr($idto,0,4)!='n.g.') {
			$tchar=explode("|",$l_i[$loc][$id]["char"]);
			addjournal($loc,"all","Безумие завладело ".$tchar[0]."!");
			$tchar[7]=$idto;
			$l_i[$loc][$id]["char"]=implode("|",(array)($tchar));
			attack($loc,$id,$idto);
			}else addjournal($loc,"all","Безумие прошло, никого не тронув");
		}else addjournal($loc,"all","Безумие никого не тронуло");
	}
