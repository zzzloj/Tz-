{
  "id": "n.Mahmet",
  "topics": {
    "get": [
      {
        "options": [
          {
            "label": "Я принес тебе черный камень",
            "goto": "qvok",
            "if": [
              {
                "has": "i.q.blackstone"
              }
            ]
          },
          {
            "label": "А тебе нужны только драгоценные камни?",
            "goto": "qv",
            "if": [
              {
                "lacks": "i.q.blackstone"
              }
            ]
          },
          {
            "label": "Ясно, у меня еще есть вопросы",
            "goto": "begin"
          },
          {
            "label": "Мне пора",
            "goto": "end"
          }
        ]
      }
    ],
    "qvok": [
      {
        "if": [
          {
            "has": "i.q.blackstone"
          }
        ],
        "do": [
          {
            "take": "i.q.blackstone"
          },
          {
            "give": "i.money",
            "count": 40
          },
          {
            "kills": 12,
            "level": 4
          }
        ],
        "text": "Отлично, давай его сюда. Да, это именно тот камень, о котором мне рассказывали. Возьми эти деньги за твой труд. Если найдешь еще такие камни, приноси тоже."
      },
      {
        "text": "Ну и где же он? Я не вижу у тебя никаких камней. "
      }
    ],
    "krip": [
      {
        "options": [
          {
            "label": "Ясно",
            "goto": "end"
          },
          {
            "label": "Я принес тебе все, что ты просил",
            "goto": "spec",
            "if": [
              {
                "has": "i.q.inst"
              },
              {
                "has": "i.q.kse"
              }
            ]
          }
        ]
      }
    ],
    "spec": [
      {
        "if": [
          {
            "has": "i.q.kse"
          },
          {
            "has": "i.q.inst"
          }
        ],
        "do": [
          {
            "take": "i.q.kse"
          },
          {
            "take": "i.q.inst"
          },
          {
            "give": "i.i.kp"
          }
        ],
        "text": "Держи свой камень. Смотри не сломай его когда инкрустировать будешь. "
      },
      {
        "text": ""
      }
    ]
  }
}