{
  "id": "n.Auron",
  "topics": {
    "begin": [
      {
        "if": [
          {
            "lacks": "i.q.guildmage"
          }
        ],
        "do": [
          {
            "teleport": "x2124x367"
          }
        ],
        "text": "У тебя нет знака гильдии магов, убирайся прочь, самозванец!",
        "options": [
          {
            "label": "Я хочу домой",
            "goto": "end"
          }
        ]
      },
      {
        "text": "Я вижу, у тебя есть знак гильдии магов. Что ж, значит охрана у башни не дремлет. Отлично, что ты хочешь, <imja>?"
      }
    ],
    "st1": [
      {
        "options": [
          {
            "label": "Вас не смущают монстры в городе?",
            "goto": "mon"
          },
          {
            "label": "Вы делаете свитки и руны?",
            "goto": "sv"
          },
          {
            "label": "Какие заклинания?",
            "goto": "zakl"
          },
          {
            "label": "Посмотри этот свиток, я думаю он будет тебе интересен...",
            "goto": "qvok",
            "if": [
              {
                "has": "i.q.svitok"
              },
              {
                "has": "i.q.kris"
              }
            ]
          },
          {
            "label": "У меня еще вопросы",
            "goto": "begin"
          }
        ]
      }
    ],
    "qv5": [
      {
        "options": [
          {
            "label": "Я принес все необходимое.",
            "goto": "qv6",
            "if": [
              {
                "has": "i.q.ambroken1"
              },
              {
                "has": "i.q.klever"
              },
              {
                "has": "i.q.darklist"
              }
            ]
          },
          {
            "label": "Я постораюсь найти все, что необходимо.",
            "goto": "end"
          }
        ]
      }
    ],
    "qv6": [
      {
        "if": [
          {
            "has": "i.q.ambroken1"
          },
          {
            "has": "i.q.klever"
          },
          {
            "has": "i.q.darklist"
          }
        ],
        "do": [
          {
            "take": "i.q.ambroken1"
          },
          {
            "take": "i.q.darklist"
          },
          {
            "take": "i.q.klever"
          },
          {
            "give": "i.q.sos"
          }
        ],
        "text": "Вот свиток. Но чтобы заклинание сработало, тебе необходимо положить камень на место смерти того, чья душа заключена в камне."
      }
    ]
  }
}